    {
        "id": "separar_safe",
        "type": "function",
        "z": "tab_kuravet_safe",
        "name": "Organiza Dados",
        "func": "var msgTemp = { payload: msg.payload.temperatura };\nvar msgUmid = { payload: msg.payload.umidade };\n\n// Tópico adicionado para o gráfico funcionar\nvar msgDist = { \n    payload: msg.payload.distancia_pet_cm, \n    topic: \"Movimentação (cm)\" \n};\n\nvar statusColor = msg.payload.status_alerta ? \"#B55D5D\" : \"#5D4057\";\nvar statusText = msg.payload.status_alerta ? \"⚠ ALERTA DE AGITAÇÃO\" : \"✅ PET EM REPOUSO\";\n\nvar msgStatus = { \n    payload: `<span style='color:${statusColor}; font-weight:bold;'>${statusText}</span>` \n};\n\nreturn [msgTemp, msgUmid, msgDist, msgStatus];",
        "outputs": 4,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 520,
        "y": 120,
